---
const { title = "HMGF UGM", description = "Himpunan Mahasiswa Geofisika UGM" } = Astro.props;
const nonce = Astro.locals.runtime?.env?.CSP_NONCE || "static";
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="csp-nonce" content={nonce} />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header"><a class="brand" href="/">HMGF <span>UGM</span></a><nav><a href="/">Beranda</a><a href="/?source=Geolibrary">Geolibrary</a><a href="/?source=SEG%20News">SEG News</a></nav></header>
    <slot />
    <footer><p>HMGF UGM · Tinggi Prestasi Tampak Membumi</p></footer>
  </body>
</html>
